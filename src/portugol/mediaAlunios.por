programa{
    
    funcao media3Valores(real a, real b, real c)
    {
         retorne resultado = (a + b + c) / 3      
         retorne resultado                                           

    }

    // real a, b, c - Variavel Global
    
    funcao inicio(){
        real aluno1 = 0.0
        real aluno2 = 0.0
        real aluno3 = 0.0

        aluno1 = media3Valores(7.4, 9.2, 3.7)
        aluno2 = media3Valores(4.1, 8, 5.2)
        aluno3 = media3Valores(6.3, 8.6, 7.7)

        escreva(" Media aluno 1: ", aluno1, "\n")
        escreva(" Media aluno 2: ", aluno2, "\n")
        escreva(" Media aluno 3: ", aluno3, "\n")
    }
}